; Рязанцев И.В., А-12-23, 17, v1
$INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
DSEG AT 30h
X1:     DS 1                    ; цифра с клавиатуры (0 — Y2 пассивен)
X2:     DS 1                    ; отсчёт из кольцевого буфера
CSEG AT 0h
        sjmp START
org 03h ; "заглушка" для INT0
        nop
        reti
org 0bh ; "заглушка" для Tmr0_ovf
        nop
        reti
org 13h ; "заглушка" для INT1
        nop
        reti
org 1bh                         ; Timer1: прошло T2 — конец строба Y2
        clr TR1                 ; таймер больше не нужен до следующего строба
        setb PIN_Y2             ; строб в пассивную 1
        reti
org 23h ; "заглушка" для UART
        nop
        reti
org 2bh
START:
; Инициализация МК **********************************************
        mov SP, #07h            ; стек сразу за банком 0 (ТЗ: SP = 07h)
        setb PIN_CSEN           ; разрешить дешифратор адреса — регистр Y2 выбирается только при CS_EN = 1
        setb PIN_Y2             ; строб пассивен
        mov TMOD, #10h          ; Timer1 — 16-битный таймер (режим 1), Timer0 не используется
        setb PT1                ; строб — высокий приоритет, чтобы длительность не плыла
        setb ET1                ; разрешить прерывание Timer1
        setb EA                 ; общее разрешение прерываний
        mov X1, #5              ; пример входных данных
        mov X2, #100
        call Y2Out ; %proc%
        jmp $ ; %stop%

; Y2Out — расчёт и выдача управляющего сигнала Y2 со стробом сопровождения.
; Y2 = (G + M + X1 + X2) mod 256 = (Y2_CONST + X1 + X2) mod 256 при X1 ≠ 0; при X1 = 0 — Y2 = 0 (пассивное).
; Вход: X1, X2 в ОЗУ. Выход: значение в регистре Y2 (ADR_Y2), строб PIN_Y2 = 0 длительностью T2
;       (конец строба — в обработчике Timer1, процедура не ждёт). Портит: A, DPTR, PSW.
Y2Out:
        mov A, X1
        jz y2_wr                ; X1 = 0 — пассивное Y2 = 0 (A уже 0)
        add A, X2               ; X1 + X2
        add A, #Y2_CONST        ; + G + M; перенос отбрасывается — это и есть mod 256
y2_wr:  mov DPTR, #ADR_Y2
        movx @DPTR, A           ; сначала данные в регистр — к началу строба они уже на выходе
        clr TR1                 ; перезапуск отсчёта, если прошлый строб ещё идёт
        mov TH1, #T2_RELOAD_H   ; до переполнения ровно T2 мкс
        mov TL1, #T2_RELOAD_L
        clr TF1                 ; старое переполнение не должно сразу закончить строб
        clr PIN_Y2              ; начало строба
        setb TR1                ; конец — в обработчике Timer1
        ret
END
