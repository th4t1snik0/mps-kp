; Рязанцев И.В., А-12-23, 17, v1
$INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
DSEG AT 30h
; переменных в ОЗУ нет — хватает регистров
CSEG AT 0h
        sjmp START
org 03h                         ; INT0 — нажатие клавиши: здесь вызывается процедура опроса
        call KbScan ; %proc%
        reti
org 0bh ; "заглушка" для Tmr0_ovf
        nop
        reti
org 13h ; "заглушка" для INT1
        nop
        reti
org 1bh ; "заглушка" для Tmr1_ovf
        nop
        reti
org 23h ; "заглушка" для UART
        nop
        reti
org 2bh
START:
; Инициализация МК **********************************************
        mov SP, #07h            ; стек сразу за банком 0 (ТЗ: SP = 07h)
        setb PIN_CSEN           ; разрешить дешифратор адреса — без него ни одно устройство не выбирается
        mov DPTR, #ADR_KB
        clr A
        movx @DPTR, A           ; все столбцы в 0: любое нажатие опустит свою строку и даст спад на INT0
        setb IT0                ; INT0 по спаду: одно нажатие — один вызов обработчика
        setb EX0                ; разрешить прерывание от клавиатуры
        setb EA                 ; общее разрешение прерываний
        jmp $ ; %stop%

; KbScan — опрос матрицы 3×4 по столбцам (вызывается из обработчика INT0).
; Вход: нет.
; Выход: A — код единственной нажатой клавиши по табл. 3 ТЗ («0»…«9» → 0…9, «Т» → 10, «С» → 11)
;        или 0FFh, если не нажато ничего или нажато больше одной клавиши.
; По выходу все столбцы снова в 0 (ждём следующее нажатие), флаг IE0 сброшен. Портит: R1–R7, DPTR, PSW.
KbScan:
        mov DPTR, #ADR_KB       ; регистр столбцов и повторитель строк — один адрес
        mov R7, #0              ; сколько замкнутых контактов найдено
        mov R6, #0FFh           ; номер последней найденной клавиши в KeyMap
        mov R5, #0              ; номер опрашиваемого столбца
        mov R4, #11111110b      ; маска столбцов: 0 — в опрашиваемом
kb_col: mov A, R4
        movx @DPTR, A           ; опустить один столбец
        movx A, @DPTR           ; прочитать строки: 0 — контакт на этом столбце замкнут
        cpl A                   ; теперь 1 — замкнут
        anl A, #(1 SHL KB_ROWS) - 1 ; оставить Row1…Row4, старшие линии шины не подключены
        mov R1, A               ; замкнутые строки этого столбца
        mov A, R5
        mov R2, A               ; номер клавиши (строка 1, этот столбец) в KeyMap
        mov R3, #KB_ROWS        ; строк проверить
kb_row: mov A, R1
        rrc A                   ; очередная строка → C
        mov R1, A
        jnc kb_skip             ; не замкнута — дальше
        inc R7                  ; ещё один замкнутый контакт
        mov A, R2
        mov R6, A               ; запомнить, какая это клавиша
kb_skip:
        mov A, R2
        add A, #KB_COLS         ; та же колонка, следующая строка
        mov R2, A
        djnz R3, kb_row
        inc R5                  ; следующий столбец
        mov A, R4
        rl A                    ; ноль маски — на следующий столбец
        mov R4, A
        cjne R5, #KB_COLS, kb_col
        clr A
        movx @DPTR, A           ; все столбцы снова в 0 — следующее нажатие снова вызовет INT0
        clr IE0                 ; спады INT0 во время опроса — не новое нажатие, лишний вызов не нужен
        mov A, #0FFh            ; ответ по умолчанию: «нет единственной клавиши»
        cjne R7, #1, kb_ret     ; ни одной или несколько — 0FFh
        mov A, R6
        mov DPTR, #KeyMap
        movc A, @A+DPTR         ; номер клавиши → её код по табл. 3
kb_ret: ret

; Коды клавиш по рис. 4 ТЗ (3×4, нечётный M), по строкам: 1 2 3 / 4 5 6 / 7 8 9 / 0 Т С
KeyMap: DB 1, 2, 3, 4, 5, 6, 7, 8, 9, 0, 10, 11
END
