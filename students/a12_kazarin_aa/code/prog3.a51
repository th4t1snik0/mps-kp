; Казарин А.А., А-12-23, 8, v1
$INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
DSEG AT 30h
X1:     DS 1                    ; цифра с клавиатуры (0 — Y2 = 0)
X2:     DS 1                    ; отсчёт из буфера
CSEG AT 0h
        sjmp START
org 03h ; "заглушка" для INT0
        nop
        reti
org 0bh ; "заглушка" для Tmr0_ovf
        nop
        reti
org 13h ; "заглушка" для INT1
        nop
        reti
org 1bh                         ; Timer1 отсчитал T2 — конец строба Y2
        clr TR1                 ; таймер больше не нужен до следующего вывода
        setb PIN_Y2             ; строб в пассивную 1
        reti
org 23h ; "заглушка" для UART
        nop
        reti
org 2bh
START:
; Инициализация МК **********************************************
        mov SP, #07h
        setb PIN_CSEN           ; разрешить дешифратор CS — иначе регистр Y2 не выбирается
        setb PIN_Y2             ; строб Y2 пассивен
        mov TMOD, #11h          ; оба таймера в режиме 1 (16 бит), строб T2 — Timer1
        setb ET1                ; прерывание Timer1 закончит строб
        setb EA
        mov X1, #3              ; пример входных данных
        mov X2, #200
        call Y2Out ; %proc%
        jmp $ ; %stop%

; Y2Out — расчёт Y2 = (G+M+X1+X2) mod 256, при X1 = 0 — Y2 = 0; вывод в регистр Y2 и запуск строба T2.
; Сначала значение пишется в регистр, потом строб опускается в 0; поднимет его обработчик Timer1.
; Вход: X1, X2. Выход: регистр Y2; PIN_Y2 = 0, Timer1 запущен на T2 мкс. Процедура не ждёт конца строба.
; Портит: A, PSW, DPTR.
Y2Out:
        mov A, X1
        jz YoOut                ; X1 = 0 — выводим 0
        add A, X2               ; X1 + X2, перенос отбрасывается (mod 256)
        add A, #Y2_CONST        ; + G + M
YoOut:
        mov DPTR, #ADR_Y2
        movx @DPTR, A           ; значение в регистр Y2 — раньше строба
        clr TR1                 ; прошлый строб мог ещё идти — перезапускаем отсчёт
        mov TH1, #T2_RELOAD_H   ; Timer1 переполнится через T2 мкс
        mov TL1, #T2_RELOAD_L
        clr TF1                 ; убрать старый запрос от таймера
        clr PIN_Y2              ; начало строба Y2
        setb TR1                ; пошёл отсчёт длительности
        ret
END
