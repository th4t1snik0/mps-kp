; Казарин А.А., А-12-23, 8, v1
$INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
DSEG AT 30h
; переменных нет — всё на регистрах и стеке
CSEG AT 0h
        sjmp START
org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
        call KbScan ; %proc%
        reti
org 0bh ; "заглушка" для Tmr0_ovf
        nop
        reti
org 13h ; "заглушка" для INT1
        nop
        reti
org 1bh ; "заглушка" для Tmr1_ovf
        nop
        reti
org 23h ; "заглушка" для UART
        nop
        reti
org 2bh
START:
; Инициализация МК **********************************************
        mov SP, #07h
        setb PIN_CSEN           ; разрешить дешифратор CS — без него клавиатура не выбирается
        mov DPTR, #ADR_KB
        clr A
        movx @DPTR, A           ; опустить все столбцы: любое нажатие замкнёт строку и даст INT0
        setb IT0                ; INT0 по спаду — удержание клавиши не вызывает обработчик повторно
        clr IE0                 ; забыть возможный ложный запрос до разрешения
        setb EX0                ; разрешить прерывание от клавиатуры
        setb EA                 ; общее разрешение прерываний
        jmp $ ; %stop%

; KbScan — опрос матрицы клавиатуры 4x3 (вызывается из обработчика INT0).
; Столбцы опускаются по одному, по прочитанным строкам ищется ровно одна замкнутая клавиша.
; Вход: нет. Выход: A — код клавиши по табл. 3 ТЗ («0»…«9», «Т» = 10, «С» = 11) или 0FFh,
; если не нажато ничего или нажато больше одной клавиши. В конце все столбцы снова в 0, IE0 сброшен.
; Портит: только A (B, DPTR, R2–R4, PSW сохраняются в стеке).
KbScan:
        push PSW
        push B
        push DPL
        push DPH
        push 02h                ; R2 банка 0
        push 03h                ; R3 банка 0
        push 04h                ; R4 банка 0
        mov DPTR, #ADR_KB
        mov R4, #0FFh           ; номер найденной клавиши в таблице; 0FFh — пока не нашли
        mov R3, #0              ; номер опрашиваемого столбца 0…KB_COLS-1
        mov R2, #11111110b      ; маска столбцов: 0 только у опрашиваемого
KsCol:
        mov A, R2
        movx @DPTR, A           ; опустить один столбец
        movx A, @DPTR           ; прочитать строки
        anl A, #(1 SHL KB_ROWS) - 1     ; оставить только подключённые строки
        xrl A, #(1 SHL KB_ROWS) - 1     ; теперь 1 — строка замкнута на этот столбец
        jz KsNext               ; в столбце ничего не нажато
        mov B, A
        dec A
        anl A, B                ; x AND (x-1) = 0 только если замкнута ровно одна строка
        jnz KsBad               ; две строки в одном столбце — несколько клавиш
        cjne R4, #0FFh, KsBad   ; клавиша уже была в другом столбце — тоже несколько
        mov A, B
        clr C
        rrc A                   ; бит строки 1/2/4 -> номер строки 0/1/2
        rl A
        rl A                    ; номер строки * KB_COLS (4 клавиши в строке)
        add A, R3               ; + номер столбца = место в таблице кодов
        mov R4, A
KsNext:
        mov A, R2
        rl A                    ; следующий столбец
        mov R2, A
        inc R3
        cjne R3, #KB_COLS, KsCol
        sjmp KsDone
KsBad:
        mov R4, #0FFh           ; несколько клавиш — результат «нет кода»
KsDone:
        clr A
        movx @DPTR, A           ; все столбцы снова опущены — ждём следующее нажатие
        mov A, R4
        cjne A, #0FFh, KsCode
        sjmp KsExit             ; ничего (или помеха) — в A остаётся 0FFh
KsCode:
        mov DPTR, #KeyCodes
        movc A, @A+DPTR         ; место в матрице -> код клавиши по табл. 3
KsExit:
        clr IE0                 ; линия INT0 дёргалась при переборе столбцов — снять лишний запрос
        pop 04h                ; R4 банка 0
        pop 03h                ; R3 банка 0
        pop 02h                ; R2 банка 0
        pop DPH
        pop DPL
        pop B
        pop PSW
        ret

; Коды клавиш по рис. 4 ТЗ (4x3): строка за строкой, в строке Col1…Col4.
KeyCodes:
        DB 1, 2, 3, 10          ; Row1: 1 2 3 Т
        DB 4, 5, 6, 11          ; Row2: 4 5 6 С
        DB 7, 8, 9, 0           ; Row3: 7 8 9 0
END
