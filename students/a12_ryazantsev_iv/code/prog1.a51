; Рязанцев И.В., А-12-23, 17, v1
$INCLUDE (vars.inc)             ; адреса, биты, константы варианта; в файл для робота mpscode вклеит его текст
DSEG AT 30h
; переменные в ОЗУ не нужны — всё держится в регистрах банка 0
CSEG AT 0h
        sjmp START
org 03h                         ; INT0 — нажатие клавиши: процедура вызывается отсюда
        call KbScan ; %proc%
        reti
org 0bh ; "заглушка" для Tmr0_ovf
        nop
        reti
org 13h ; "заглушка" для INT1
        nop
        reti
org 1bh ; "заглушка" для Tmr1_ovf
        nop
        reti
org 23h ; "заглушка" для UART
        nop
        reti
org 2bh
START:
; Инициализация МК **********************************************
        mov SP, #07h
        setb PIN_CSEN           ; включить дешифратор CS, без него movx никуда не попадёт
        mov DPTR, #ADR_KB       ; регистр столбцов клавиатуры
        clr A
        movx @DPTR, A           ; все столбцы в 0: любое нажатие опустит строку и даст INT0
        setb IT0                ; INT0 по спаду — одно прерывание на одно нажатие
        clr IE0                 ; забыть возможный спад, пойманный до настройки
        setb EX0                ; разрешить прерывание от клавиатуры
        setb EA                 ; общее разрешение прерываний
        jmp $ ; %stop%

; KbScan — опрос матрицы клавиатуры 3x4 по столбцам (вызывается из обработчика INT0).
; Столбцы опускаются по одному, по прочитанным строкам считаются замкнутые контакты.
; Вход: нет. Выход: A — код клавиши по табл. 3 ТЗ, если замкнута ровно одна; иначе 0FFh.
; Портит: A, флаги (R0–R5, DPTR сохраняются в стеке). После опроса все столбцы снова в 0, IE0 сброшен.
KbScan:
        push DPL                ; DPTR и рабочие регистры банка 0 вернём как было
        push DPH
        push 00h
        push 01h
        push 02h
        push 03h
        push 04h
        push 05h
        mov R4, #0FFh           ; найденный код: пока ничего
        mov R3, #0              ; счётчик замкнутых контактов
        mov R2, #0              ; номер текущего столбца, с нуля
        mov R5, #0FEh           ; маска столбцов: 0 только у опрашиваемого
KbCol:
        mov DPTR, #ADR_KB
        mov A, R5
        movx @DPTR, A           ; опустить текущий столбец, остальные держать в 1
        movx A, @DPTR           ; снять состояние строк
        anl A, #(1 SHL KB_ROWS) - 1     ; старшие биты шины не подключены — отбросить
        xrl A, #(1 SHL KB_ROWS) - 1     ; теперь 1 = строка замкнута на этот столбец
        jz KbNextCol            ; в столбце ничего не нажато
        mov R0, A               ; биты замкнутых строк, разбираем с младшей (Row1)
        mov A, R2
        mov R1, A               ; индекс в KeyTab для Row1 = номер столбца
KbRow:
        mov A, R0
        clr C                   ; сверху заходит 0, чтобы цикл кончился
        rrc A                   ; бит текущей строки — в перенос
        mov R0, A
        jnc KbRowNext           ; эта строка не замкнута
        inc R3                  ; ещё один замкнутый контакт
        mov A, R1
        mov DPTR, #KeyTab
        movc A, @A+DPTR         ; код клавиши на пересечении строки и столбца
        mov R4, A
KbRowNext:
        mov A, R1
        add A, #KB_COLS         ; следующая строка в таблице — на KB_COLS дальше
        mov R1, A
        mov A, R0
        jnz KbRow               ; остались ещё замкнутые строки ниже
KbNextCol:
        mov A, R5
        rl A                    ; ноль переезжает на следующий столбец
        mov R5, A
        inc R2
        cjne R2, #KB_COLS, KbCol        ; пока не прошли все столбцы
        mov DPTR, #ADR_KB
        clr A
        movx @DPTR, A           ; вернуть все столбцы в 0 — ждать следующее нажатие
        mov A, R4               ; ответ, если контакт один
        cjne R3, #1, KbNoKey    ; ноль или несколько контактов — помеха или двойное нажатие
        sjmp KbExit
KbNoKey:
        mov A, #0FFh
KbExit:
        clr IE0                 ; спады INT0 во время перебора столбцов — не новое нажатие
        pop 05h
        pop 04h
        pop 03h
        pop 02h
        pop 01h
        pop 00h
        pop DPH
        pop DPL
        ret

; Коды клавиш (табл. 3 ТЗ) в порядке строка*KB_COLS + столбец, раскладка рис. 4 (3x4):
; Row1: 1 2 3 | Row2: 4 5 6 | Row3: 7 8 9 | Row4: 0 Т С
KeyTab: DB 1, 2, 3, 4, 5, 6, 7, 8, 9, 0, 10, 11
END
